{
  "keel": 1,
  "name": "onda",
  "profile": "tauri-web",
  "platforms": {
    "tier1": ["windows-x64", "linux-x64"],
    "tier2": ["macos-arm64", "windows-arm64", "linux-arm64", "macos-x64"],
    "tier3": ["fedora", "debian", "arch"]
  },
  "commands": {
    "lint": "cargo fmt --all --check && cargo clippy --locked --workspace --all-targets -- -D warnings && npx tsc --noEmit",
    "unit": "cargo test --locked --workspace && npm run test:unit",
    "contracts": "npm run contracts:check && npm run test:unit",
    "integration": "cargo test --locked --workspace",
    "ui": null,
    "e2e": "npm run test:e2e",
    "build": "npm run build:e2e",
    "package": "npm run release",
    "installers": null
  },
  "paths": {
    "ui": "ui/",
    "native": "src-tauri/",
    "contracts": "ui/src/generated/",
    "e2e": "tests/e2e/"
  }
}
