{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx", "jsxImportSource": "preact"
  },
  "include": ["ui/src/**/*.ts", "ui/src/**/*.tsx", "contracts/**/*.ts", "tests/unit/**/*.ts"]
}
