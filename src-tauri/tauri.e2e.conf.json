{
  "$schema": "https://schema.tauri.app/config/2",
  "build": { "beforeBuildCommand": "npm run build:e2e-ui" },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "main-local",
        "pill-local",
        {
          "identifier": "e2e-main",
          "description": "Debug real-shell test builds only: WebdriverIO drives and inspects the main window.",
          "windows": ["main"],
          "permissions": ["core:default", "core:window:default", "wdio:default", "wdio-webdriver:default"]
        }
      ]
    }
  }
}
