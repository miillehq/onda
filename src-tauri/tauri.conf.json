{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Onda", "version": "0.3.0", "identifier": "com.miille.onda",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "Onda", "create": false, "width": 1120, "height": 780, "minWidth": 760, "minHeight": 560, "center": true }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'" }
  },
  "plugins": { "updater": { "pubkey": "", "endpoints": [], "requireSignedVersion": true } },
  "bundle": {
    "active": true, "targets": ["nsis"], "category": "Productivity",
    "shortDescription": "Voice dictation that types where your cursor is",
    "copyright": "Copyright 2026 Onda contributors", "license": "Apache-2.0",
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "externalBin": ["binaries/onda-input", "binaries/onda-asr-worker", "binaries/onda-asr-avx2-worker"],
    "resources": { "../LICENSE": "LICENSE", "../NOTICE": "NOTICE", "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt" },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "minimumWebview2Version": "120.0.2210.55",
      "nsis": {
        "installMode": "currentUser", "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico", "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/installer/header.bmp", "uninstallerHeaderImage": "icons/installer/header.bmp",
        "sidebarImage": "icons/installer/sidebar.bmp"
      }
    },
    "createUpdaterArtifacts": false
  }
}
