          "const": "openaiCompatible",
          "description": "A user-configured server that speaks the OpenAI Chat Completions API.",
          "type": "string"
        },
        {
          "const": "anthropic",
          "description": "Anthropic's Messages API with the user's own API key.",
          "type": "string"
        },
        {
          "const": "local",
