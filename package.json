{
  "name": "onda-dictation",
  "version": "0.3.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:e2e-ui": "tsc --noEmit && vite build --mode e2e",
    "build:e2e": "tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "test:unit": "vitest run && npm run test:tooling",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "package:desktop": "node scripts/desktop-package.mjs package",
    "test:installers": "node scripts/desktop-package.mjs installers",
    "test:ui": "playwright test",
    "test:production-ui": "npm run build -- --outDir ../artifacts/production-ui && playwright test -c playwright.production.config.ts",
    "test:ui:update": "cross-env UPDATE_SNAPSHOTS=1 playwright test --update-snapshots=all",
    "test:e2e": "wdio run wdio.conf.ts",
    "contracts": "cargo run -p onda-core --bin onda-contracts && cargo run -p onda-app --features wire-schema --example onda-api-contracts",
    "contracts:check": "cargo run -p onda-core --bin onda-contracts -- --check && cargo run -p onda-app --features wire-schema --example onda-api-contracts -- --check",
    "tauri": "tauri",
    "desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "readme:images": "node scripts/readme-images/render.mjs",
    "quality": "cargo run -p onda-core --release --bin onda-quality",
    "lint": "npm run lint:source && cargo fmt --all --check && cargo clippy --locked --workspace --all-targets -- -D warnings",
    "lint:source": "tsc --noEmit && tsc -p tests/ui/tsconfig.json --noEmit && tsc -p tests/e2e/tsconfig.json --noEmit && biome lint && knip && knip --production && node scripts/quality/architecture.mjs",
    "triage": "node scripts/triage.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@preact/signals": "2.11.3",
    "@tauri-apps/api": "2.12.1",
    "lucide-preact": "1.52.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@cfworker/json-schema": "4.1.6",
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "24.19.2",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/native-types": "2.6.1",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-plugin": "1.5.1",
    "@wdio/tauri-service": "1.5.1",
    "cross-env": "10.1.0",
    "happy-dom": "21.0.4",
    "jsonc-parser": "3.3.1",
    "knip": "6.46.1",
    "parse5": "7.3.0",
    "postcss": "8.5.31",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@puppeteer/browsers@^2": "3.2.7",
    "glob@>=9.0.0 <=14.0.1": "14.0.6",
    "readdir-glob@3": {
      "minimatch": "11.0.9"
    },
    "serialize-javascript@<7.1.3": "7.1.4"
  }
}
