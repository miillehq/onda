{
  "name": "onda-dictation",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:e2e-ui": "tsc --noEmit && vite build --mode e2e",
    "build:e2e": "tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "test:unit": "vitest run",
    "test:ui": "playwright test",
    "test:ui:update": "cross-env UPDATE_SNAPSHOTS=1 playwright test --update-snapshots=all",
    "test:e2e": "wdio run wdio.conf.ts",
    "contracts": "cargo run -p onda-core --bin onda-contracts && cargo run -p onda-app --example onda-api-contracts",
    "contracts:check": "cargo run -p onda-core --bin onda-contracts -- --check && cargo run -p onda-app --example onda-api-contracts -- --check",
    "tauri": "tauri",
    "desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "readme:images": "node scripts/readme-images/render.mjs",
    "quality": "cargo run -p onda-core --release --bin onda-quality"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@preact/signals": "2.11.3",
    "@tauri-apps/api": "2.12.1",
    "lucide-preact": "1.52.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "24.19.2",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/native-types": "2.6.1",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-plugin": "1.5.1",
    "@wdio/tauri-service": "1.5.1",
    "cross-env": "10.1.0",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
